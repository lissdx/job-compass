!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# ── BMAD ──────────────────────────────────────────────────────────────
# Tooling and its generated artifacts, not project source.
_bmad/
_bmad-output/

# ── Claude Code ───────────────────────────────────────────────────────
# .claude/ currently holds a vendored BMAD skill catalog (54 skills from
# the 6.11.0 distribution), not project-authored configuration. Ignored
# until we decide whether this project is driven from here at all.
# Revisit when we author our own skills — those belong in the repo.
.claude/
CLAUDE.local.md

# ── Application data ──────────────────────────────────────────────────
# The database holds real applications, real companies and real people's
# contact details. Schema and migrations are source; the data is not.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
exports/

# ── AI / retrieval artifacts ──────────────────────────────────────────
# Regenerable from source; large and binary.
.chroma/
chroma_db/
*.faiss
*.index
embeddings/
.cache/

